  (text "GPIO27 = FUNERALE, GPIO32 = MESSA, GPIO36 = IN 3, GPIO39 = IN 4." (at 19 252.17 0) (effects (font (size 2.0 2.0)) (justify left bottom)) (uuid e259a571-7b26-4038-b3f0-712149d5a2f6))
  (text "Non collegare nulla a GPIO12 (pin di avvio). Zona antenna del T-Display senza rame." (at 19 256.67 0) (effects (font (size 2.0 2.0)) (justify left bottom)) (uuid 5647ed8d-a2bf-4ff5-ba05-718a89ef90e9))
